# ChottoDay Environment Variables
# Base URL for Toolio interactive miniapps
VITE_TOOLIO_BASE_URL=https://toolio.chottoday.com

# Endpoint that receives the /about contact form (POST, JSON).
# Unset in development: the form then shows the hello@chottoday.com fallback
# instead of pretending a message was delivered.
VITE_CONTACT_ENDPOINT=

# --- Newsroom (soạn nháp tin hằng ngày) -------------------------------------
# Khoá API của nhà cung cấp tương thích OpenAI. Trên GitHub đây là *secret*.
OPENAI_API_KEY=

# Tên model. Trên GitHub đây là *variable*, không phải secret.
# Bỏ trống thì dùng mặc định gpt-5.6-luna.
NEWSROOM_MODEL=

# Chỉ đặt khi model KHÔNG nằm trên endpoint mặc định của OpenAI —
# ví dụ khi dùng gateway riêng. Bỏ trống thì SDK tự dùng api.openai.com.
OPENAI_BASE_URL=
