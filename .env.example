# ChottoDay Environment Variables
# Base URL for Toolio interactive miniapps
VITE_TOOLIO_BASE_URL=https://toolio.chottoday.com

# Endpoint that receives the /about contact form (POST, JSON).
# Unset in development: the form then shows the hello@chottoday.com fallback
# instead of pretending a message was delivered.
VITE_CONTACT_ENDPOINT=
